# x265-Converter - Zmienne środowiska

# ===== PORT I HOST =====
PORT=3001
HOST=0.0.0.0

# ===== URL DOSTĘPU =====
# Zmień na IP Twojego Unraid
PUBLIC_URL=http://192.168.X.X:3001

# ===== NODE.JS =====
NODE_ENV=production

# ===== OPCJE PRZEGLĄDARKI =====
# 0 = nie otwieraj przeglądarki (dla Unraid powinno być 0)
AUTO_OPEN_BROWSER=0

# ===== OTWIERANIE PLIKÓW =====
# 0 = wyłącz (dla Unraid powinno być 0)
FILE_OPEN_ENABLED=0

# ===== FOLDER TYMCZASOWY =====
# Wewnątrz kontenera
APP_TMP_DIR=/tmp/x265-converter

# ===== FFMPEG / FFPROBE =====
# Ścieżki do binariów (opcjonalnie, jeśli inny obraz)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ===== LIMITY ZASOBÓW (dla docker-compose) =====
# CPU: liczba rdzeni (np. 4, 2.5)
# Pozostawić puste, by użyć domyślnych
# CPU_LIMIT=4
# MEMORY_LIMIT=2G
